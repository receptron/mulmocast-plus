{
  "name": "mulmocast-plus",
  "version": "0.0.1",
  "description": "Monorepo for mulmocast-cli derivative packages",
  "private": true,
  "scripts": {
    "build": "yarn workspace @mulmocast/extended-types build && yarn workspace @mulmocast/script-utils build && yarn workspaces run build",
    "typecheck": "yarn workspace @mulmocast/extended-types build && yarn workspace @mulmocast/script-utils build && yarn workspaces run typecheck",
    "lint": "yarn workspaces run lint",
    "format": "yarn workspaces run format",
    "test": "yarn workspaces run test",
    "knip": "knip"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "resolutions": {
    "minimatch": "^10.2.6"
  },
  "author": "receptron",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
