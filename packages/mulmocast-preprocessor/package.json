{
  "name": "mulmocast-preprocessor",
  "version": "0.6.1",
  "description": "Preprocessor for MulmoScript",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "mulmocast-preprocessor": "./lib/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "./lib"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "node --import tsx --test test/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmocast-plus.git"
  },
  "author": "receptron",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/receptron/mulmocast-plus/issues"
  },
  "homepage": "https://github.com/receptron/mulmocast-plus#readme",
  "dependencies": {
    "@graphai/anthropic_agent": "^2.1.0",
    "@graphai/gemini_agent": "^2.1.0",
    "@graphai/groq_agent": "^2.1.0",
    "@graphai/openai_agent": "^2.1.0",
    "@graphai/vanilla": "^2.0.12",
    "@mulmocast/extended-types": "^0.3.0",
    "@mulmocast/script-utils": "^0.1.0",
    "@mulmocast/types": "^2.21.0",
    "dotenv": "^18.0.8",
    "graphai": "^2.0.18",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  }
}
